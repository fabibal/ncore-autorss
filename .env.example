# Copy to .env and fill in. The .env file is gitignored.

# nCore RSS passkey -- the key= value from your nCore RSS feed URL
# (https://ncore.pro/rss.php?key=THIS)
NCORE_RSS_KEY=your_ncore_rss_passkey

# Grafana, for the "recent films" text panel and dashboard updates
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASS=your_grafana_password

# NOTE: the Deepseek API key is read from a separate file
# (autorss_common.TRADING_ENV, path set in autorss_common.py),
# as the variable DEEPSEEK -- it is not stored in this project's .env.
